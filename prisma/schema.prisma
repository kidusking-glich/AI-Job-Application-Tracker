generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum ContractLanguage {
  ENGLISH
  AMHARIC
  OTHER
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ClauseSentiment {
  FAVORABLE
  NEUTRAL
  UNFAVORABLE
  RISKY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ------------------------------
// Entities
// ------------------------------

model User {
  id        String      @id @default(uuid())
  email     String      @unique
  password  String
  name      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?   @map("deleted_at")

  // Relationships
  contracts  Contract[]
  analyses   Analysis[]

  @@map("users")
}

model Contract {
  id        String           @id @default(uuid())
  title     String
  content   String?          // Extracted/pasted text content
  fileUrl   String?          // Path to uploaded file
  language  ContractLanguage @default(ENGLISH)
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?        @map("deleted_at")

  // Relationships
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clauses   ContractClause[]
  analyses  Analysis[]

  @@map("contracts")
}

model ContractClause {
  id          String            @id @default(uuid())
  contractId  String
  clauseNumber Int
  title       String?
  content     String            // The actual clause text
  pageNumber  Int?              // If extracted from a PDF, which page
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relationships
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  analyses    ClauseAnalysis[]

  @@index([contractId, clauseNumber])
  @@map("contract_clauses")
}

model Analysis {
  id            String         @id @default(uuid())
  contractId    String
  userId        String
  status        AnalysisStatus @default(PENDING)
  overallScore  Int?           // 1-100 score (higher = better)
  riskLevel     RiskLevel?     @default(LOW)
  summary       String?        // Overall summary of the contract analysis
  keyFindings   Json?          // JSON array of key findings
  recommendations Json?        // JSON array of recommendations
  errorMessage  String?        // If analysis failed
  processedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relationships
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clauseAnalyses ClauseAnalysis[]

  @@map("analyses")
}

model ClauseAnalysis {
  id              String          @id @default(uuid())
  analysisId      String
  clauseId        String
  clauseNumber    Int
  clauseTitle     String?
  clauseText      String          // Snapshot of the clause text at analysis time
  sentiment       ClauseSentiment
  riskLevel       RiskLevel       @default(LOW)
  explanation     String?         // Why this clause is good/bad
  suggestion      String?         // Suggested improvement or alternative wording
  severity        Int?            // 1-10 severity (10 = worst)
  createdAt       DateTime        @default(now())

  // Relationships
  analysis        Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  clause          ContractClause  @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@map("clause_analyses")
}
