
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



// ------------------------------
// Enums
// ------------------------------
enum ApplicationStatus {
  WISHLIST
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  ACCEPTED
}

// ------------------------------
// Entities
// ------------------------------

model User {
  id            String                  @id @default(uuid())
  email         String                  @unique
  password      String
  name          String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  deletedAt     DateTime?               @map("deleted_at") // Soft delete support

  // Relationships
  applications  Application[]
  resumes       Resume[]
  coverLetters  CoverLetter[]
  questions     InterviewQuestion[]
  statusHistory ApplicationStatusHistory[]

  @@map("users")
}

model Company {
  id           String        @id @default(uuid())
  name         String
  website      String?
  industry     String?
  headquarters String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?     @map("deleted_at") // Soft delete support

  // Relationships
  jobs         Job[]

  @@map("companies")
}

model Job {
  id             String                  @id @default(uuid())
  title          String
  description    String?
  location       String?
  salary         String?
  jobType        String? // Full-time, Part-time, Contract, etc.
  postedAt       DateTime?
  postedUrl      String?
  companyId      String
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?               @map("deleted_at") // Soft delete support

  // Relationships
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications   Application[]
  questions      InterviewQuestion[]

  @@map("jobs")
}

model Application {
  id               String                      @id @default(uuid())
  status           ApplicationStatus           @default(WISHLIST)
  notes            String?
  appliedAt        DateTime?
  userId           String
  jobId            String
  resumeId         String?
  coverLetterId    String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  deletedAt        DateTime?                   @map("deleted_at") // Soft delete support

  // Relationships
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job                         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume           Resume?                     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  coverLetter      CoverLetter?                @relation(fields: [coverLetterId], references: [id], onDelete: SetNull)
  statusHistory    ApplicationStatusHistory[]
  questions        InterviewQuestion[]

  @@map("applications")
}

model ApplicationStatusHistory {
  id             String             @id @default(uuid())
  applicationId  String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  changedAt      DateTime           @default(now())
  changedById    String
  notes          String?

  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy      User               @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model Resume {
  id           String         @id @default(uuid())
  title        String
  content      String? // Can store text, or a URL
  fileUrl      String? // URL to the uploaded resume file
  userId       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      @map("deleted_at") // Soft delete support

  // Relationships
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("resumes")
}

model CoverLetter {
  id           String         @id @default(uuid())
  title        String
  content      String?
  fileUrl      String? // URL to the uploaded cover letter file
  userId       String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      @map("deleted_at") // Soft delete support

  // Relationships
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("cover_letters")
}

model InterviewQuestion {
  id           String         @id @default(uuid())
  question     String
  answer       String?
  userId       String
  jobId        String? // Optional, can be linked to a specific job
  applicationId String? // Optional, can be linked to a specific application
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?      @map("deleted_at") // Soft delete support

  // Relationships
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job          Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application  Application?   @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@map("interview_questions")
}
