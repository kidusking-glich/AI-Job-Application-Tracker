# Frontend environment variables
# Copy to frontend/.env and adjust. Never commit real values.

# Telebirr donation phone number shown in the footer and dashboard
VITE_TELEBIRR_PHONE=09XX XXX XXX

# Public base URL of the deployed frontend (no trailing slash).
# Used for canonical URLs and social sharing meta tags (og:url, og:image, twitter:image).
# Example: VITE_SITE_URL=https://contract-reader.example.com
VITE_SITE_URL=
